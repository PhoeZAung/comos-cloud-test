    "maintainedBaseLimit": 1,
    "maintainedSongLimitModifiedBy": "ffd20:class:bard:feature:medley",
    "activeEffectAutomation": "manual",
    "tieredSongs": "Different song-level versions are distinct learned entries; not class ability upgrade events."
