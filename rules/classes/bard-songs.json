  "review": {
    "state": "needs_review",
    "coverage": "partial_levels_0_to_2",
    "complete": false,
    "issues": [
      {
        "blocking": true,
        "path": "/songs",
        "reason": "Only levels 0–2 are indexed; song levels 3–6 remain to be extracted from the current website before this can be a complete catalog."
      },
      {
        "blocking": true,
        "path": "/songs/*/summary",
        "reason": "These entries contain short source-index paraphrases. Individual song detail pages, saves, durations, costs, mechanics and edge cases require independent review."
      },
      {
        "blocking": true,
        "path": "/rules/maintained",
        "reason": "Maintained songs require per-round management, targeting, ongoing saves/resistance and the Medley class feature; not yet implemented in the save or combat engine."
      },
      {
        "blocking": true,
        "path": "/rules/learning",
        "reason": "Song learning must validate Bard level, Charisma, existing songs, MP and orchestration rolls; player selections remain disabled until the Bard adapter is built."
      }
    ]
  },
