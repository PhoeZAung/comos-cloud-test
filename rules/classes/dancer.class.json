    "features": [
      {
        "id": "ffd20:class:dancer:feature:proficiencies",
        "name": "Weapon and Armor Proficiency",
        "atLevel": 1,
        "description": "Proficient with simple weapons, monk weapons, and bladed scarves. No armor or shield proficiency, except dancing scarves. A bladed scarf may be wielded as a one-handed melee weapon.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Weapon and Armor Proficiency",
            "locator": "proficiencies"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:ac-bonus",
        "name": "AC Bonus",
        "atLevel": 1,
        "description": "When unarmored and unencumbered, add a positive Charisma bonus to AC and CMD under the source conditions. Other ability-score AC bonuses do not stack. Suppressed by armor (except dancing scarves), shield, medium/heavy load, immobilization, or helplessness. This conditional bonus remains manual in the first-level integration.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "AC Bonus",
            "locator": "ac-bonus"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:unarmed-strike",
        "name": "Unarmed Strike",
        "atLevel": 1,
        "description": "Gain Improved Unarmed Strike. Level-1 unarmed damage is 1d4 Small, 1d6 Medium, or 1d8 Large; apply full Strength modifier. May deal lethal or nonlethal damage without the usual penalty. Treat the strike as both manufactured and natural for applicable effects.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Unarmed Strike",
            "locator": "unarmed-strike"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:battle-dance",
        "name": "Battle Dance",
        "atLevel": 1,
        "description": "At level 1, use Inspire Courage for 4 + Charisma modifier rounds per day. Start with a move action and maintain each round as a free action. Armor other than dancing scarves prevents benefits. Only one battle dance can run at a time; performance stops when the dancer cannot maintain it. Inspire Courage grants the source-defined +1 morale protection against charm/fear and +1 competence to attacks and weapon damage at level 1. Benefits remain manual.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Battle Dance",
            "locator": "battle-dance"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:fleet",
        "name": "Fleet",
        "atLevel": 1,
        "description": "While performing a battle dance, gain +10 feet enhancement to land speed at level 1. No speed bonus applies while not performing; this conditional increase remains manual.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Fleet",
            "locator": "fleet"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:perfect-dance",
        "name": "Perfect Dance",
        "atLevel": 1,
        "description": "Limit Break: as a swift action, gain +2 dodge AC and +2 insight to attacks and skill checks for 1 round at level 1. Apply only while the limit break is active.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Perfect Dance",
            "locator": "perfect-dance"
          }
        ]
      },
      {
        "id": "ffd20:class:dancer:feature:trance",
        "name": "Trance",
        "atLevel": 1,
        "description": "Limit Break: as a swift action, perform a known battle or mystic dance without its performance-round or ki cost for 1 round at level 1. This does not grant later-level dances or a ki pool.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Trance",
            "locator": "trance"
          }
        ]
      }
    ],
