  "data": {
    "features": [
      {
        "id": "ffd20:archetype:thief:keyblade-master:feature:bond-breaker",
        "name": "Bond Breaker",
        "atLevel": 1,
        "description": "At 1st level, a keyblade master adds half her thief level to Escape Artist checks and Disable Device checks made to open locks, and never takes a penalty on Disable Device checks when using improvised tools to open locks.\n\nThis ability replaces trapfinding.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Bond Breaker",
            "locator": "bond-breaker"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:keyblade-master:feature:keyblade",
        "name": "Keyblade",
        "atLevel": 2,
        "description": "At 2nd level, a keyblade master can use improvised tools such as any weapon from the light blades weapon group to use as a Disable Device to open locks. Any enhancement bonuses of the weapon add a +2 bonus to Disable Device per plus.\n\nThis ability replaces a thief talent gained at 2nd level.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Keyblade",
            "locator": "keyblade"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:keyblade-master:feature:open-the-cage",
        "name": "Open the Cage",
        "atLevel": 3,
        "description": "At 3rd level, a keyblade master can open a lock with astounding speed. The keyblade master can use the Disable Device check to attempt to open a lock as a standard action at 3rd level, as a move action at 10th level, and as a free action at 17th level. In addition, the keyblade master can also sense the presence of traps on locking mechanisms. This functions as the trap spotter thief talent, but applies only when the keyblade master comes within 10 feet of a trapped lock. If the keyblade master selects the trap spotter thief talent, she gains a +5 bonus on her passive Perception check to spot the trap.\n\nThis ability replaces measure the mark.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "mixed",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Open the Cage",
            "locator": "open-the-cage"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:keyblade-master:feature:bypass-ward",
        "name": "Bypass Ward",
        "atLevel": 4,
        "description": "At 4th level, ancient ruins often contain locked and sometimes warded doors; as such, a keyblade master can pick the lock of even a magically locked door. The Disable Device DC for the door is considered 10 higher than normal due to the effect of the warding spell. A keyblade master also gains a +2 competence bonus to Disable Device checks. As a full-round action, a keyblade master can make a Disable Device check to disable a magical trap for 1 minute.\n\nThis ability replaces a thief talent gained at 4th level.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "mixed",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Bypass Ward",
            "locator": "bypass-ward"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:keyblade-master:feature:rum-dubber",
        "name": "Rum Dubber",
        "atLevel": 7,
        "description": "At 7th level, whenever a keyblade master attempts to open a lock without a set of thieves\u2019 tools, the DC increases by 2, instead of 10.\n\nThis ability replaces skilled liar.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Rum Dubber",
            "locator": "rum-dubber"
          }
        ]
      }
    ],
