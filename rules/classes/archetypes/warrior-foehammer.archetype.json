        "id": "ffd20:archetype:warrior:foehammer:feature:chosen-weapon",
        "name": "Chosen Weapon",
        "atLevel": 1,
        "description": "At 1st level, a foehammer must choose hammers or flails weapon group as his chosen weapon group.\n\nThis ability modifies chosen weapon.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
