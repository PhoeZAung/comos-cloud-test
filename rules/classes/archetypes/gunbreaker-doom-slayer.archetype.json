            "locator": "doom-gun-arm"
          }
        ]
      },
      {
        "id": "ffd20:archetype:gunbreaker:doom-slayer:feature:ravenous-hatred",
        "name": "Ravenous Hatred",
        "atLevel": 2,
        "description": "When a chainsaw hit leaves a foe at 10 or fewer HP, that foe must make a Fortitude save (DC 10 + half Gunbreaker level + Wisdom modifier). Failure reduces the foe to -1 HP and bleeding. This ability replaces Keen Edge. The target HP, save, and damage are adjudicated manually.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
