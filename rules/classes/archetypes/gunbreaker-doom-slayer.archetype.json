            "locator": "praetor-sacrament"
          }
        ]
      },
      {
        "id": "ffd20:archetype:gunbreaker:doom-slayer:feature:doom-gun-arm",
        "name": "Doom Gun Arm",
        "description": "Begins with a unique chainsaw-form gun arm and Gunsmithing bonus feat. The weapon can switch between pistol, shotgun, and chaingun forms at level 1 (move action); track the active form, rounds, reloads, ranges and attacks manually. Later forms have level prerequisites and are not available at level 1.",
        "activation": "active",
        "atLevel": 1,
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
