      {
        "id": "ffd20:archetype:gunbreaker:doom-slayer:feature:praetor-sacrament",
        "name": "Praetor Sacrament",
        "description": "At first level, Praetor armor is scale mail. While wearing it, Doom Slayer gains +2 circumstance Intimidate, +10 feet land speed even when wearing heavy armor, and +2 circumstance damage against demons, devils, and undead. These are armor- and target-conditional effects tracked manually.",
        "activation": "passive",
        "atLevel": 1,
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
