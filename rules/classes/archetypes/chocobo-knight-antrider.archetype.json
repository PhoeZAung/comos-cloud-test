  "review": {
    "state": "needs_review",
    "coverage": "partial",
    "issues": [
      {
        "path": "/data/choicePools",
        "blocking": true,
        "reason": "Maneuver Tactics requires an eligible maneuver feat and verified prerequisites at levels 1/9/17. The current archive has no imported verified maneuver-feat eligibility catalog or chooser."
      },
      {
        "path": "/data/deferredReplacements",
        "blocking": true,
        "reason": "Five later parent-feature replacement targets are not yet staged in the first-level Chocobo Knight definition. Names and source locators are retained without inventing parent canonical IDs."
      },
      {
        "path": "/data/mount/poison",
        "blocking": true,
        "reason": "Source prints Fort DC 17, but its formula 10 + half HD + CON with first-level mount HD 2 and CON 21 gives 16. Both are preserved for review; no poison DC is automated."
      },
      {
        "path": "/data/mount/progression",
        "blocking": true,
        "reason": "Table lists conditional skill/feat/trick values; the prose distinguishes mindless companions and extra tricks. Hive Guard separately grants Coordinated Defense despite the no-feats language. Keep these conditions and exceptions manual pending independent review."
      },
      {
        "path": "/data",
        "blocking": true,
        "reason": "Antica-only eligibility, the companion model, combat-feat choices, resource actions and specialized runtime adapter require verification before enabling. Structural validation is not gameplay approval."
      }
    ]
  },
  "data": {
    "requiredRaceId": "ffd20:race:antica",
    "features": [
      {
        "id": "ffd20:archetype:chocobo-knight:antrider:feature:ant-steed",
        "name": "Ant Steed",
        "atLevel": 1,
        "description": "Gain a six-legged knight ant mount. Use the source starting statistics and 20-row mount table. The companion has d8 Hit Dice, 3/4 BAB and good Fortitude. Mindlessness prevents ordinary skill points and feats until Intelligence becomes at least 1. Its printed poison DC and formula disagree at first level; do not silently resolve this. Replaces Chocobo Mount.",
        "featureKind": "class_feature",
        "activation": "passive",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Ant Steed",
            "locator": "complete feature description"
          }
        ]
      },
      {
        "id": "ffd20:archetype:chocobo-knight:antrider:feature:maneuver-tactics",
        "name": "Maneuver Tactics",
        "atLevel": 1,
        "description": "Choose an Improved combat maneuver feat for which you meet prerequisites. As a standard action, grant it to allies within 30 feet for 3 rounds + 1 per two Chocobo Knight levels, regardless of their hearing, sight or prerequisites. One use/day at level 1, +1 at levels 5, 10, 15 and 20. At level 9 choose a second Improved or Greater maneuver feat and activation becomes swift. At 17 choose a third Improved, Greater or Strike feat. You must meet each chosen feat’s prerequisites. Replaces Challenge. Feat selection and prerequisites are not implemented.",
        "featureKind": "class_feature",
        "activation": "active",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Maneuver Tactics",
            "locator": "complete feature description"
          }
        ],
        "initialState": {
          "startAction": "standard",
          "featSlots": 1,
          "allowedFeatTiers": "Improved"
        }
      },
      {
        "id": "ffd20:archetype:chocobo-knight:antrider:feature:mindlink",
        "name": "Mindlink",
        "atLevel": 4,
        "description": "While conscious, allies within the Antica’s limited telepathy range (normally 30 feet) gain +2 morale on saves against charm/compulsion and +1 morale on attacks while flanking. Both increase by 1 at levels 8, 12, 16 and 20. Conditional effects remain manual. Replaces Expert Trainer and Master Feeder.",
        "featureKind": "class_feature",
        "activation": "passive",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Mindlink",
            "locator": "complete feature description"
          }
        ],
        "initialState": {
          "charmCompulsionSaveMorale": 2,
          "flankingAttackMorale": 1
        }
      },
      {
        "id": "ffd20:archetype:chocobo-knight:antrider:feature:acidic-bite",
        "name": "Acidic Bite",
        "atLevel": 7,
        "description": "The ant mount’s bite deals an additional 1d6 earth damage, increasing to 2d6 at level 15. The source specifies earth despite the feature’s name. Replaces Improved Chocobo Mount and Superior Chocobo Mount.",
        "featureKind": "class_feature",
        "activation": "passive",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Acidic Bite",
            "locator": "complete feature description"
          }
        ],
        "initialState": {
          "extraDamageDice": 1,
          "extraDamageDieSides": 6,
          "element": "earth"
        }
      },
      {
        "id": "ffd20:archetype:chocobo-knight:antrider:feature:mindlink-pulse",
        "name": "Mindlink Pulse",
        "atLevel": 15,
        "description": "As a standard action, send a pulse to allies within limited telepathy range. In a surprise round, allies otherwise unable to act can act with initiative equal to the lower of their initiative roll or the Antrider’s initiative minus 1. The pulse removes flat-footedness from affected allies, including outside surprise rounds. Replaces Protect the Meek.",
        "featureKind": "class_feature",
        "activation": "active",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Mindlink Pulse",
            "locator": "complete feature description"
          }
        ]
      }
    ],
