    "features": [
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:finisher-amendments",
        "name": "Finisher amendments",
        "atLevel": 1,
        "description": "The feral guardian\u2019s warrior limit breaks no longer need chosen weapon to function.\n\nThis ability modifies the warrior\u2019s standard limit breaks.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Limit Breaks",
            "locator": "limit-breaks"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:animal-companion",
        "name": "Animal Companion",
        "atLevel": 1,
        "description": "At 1st level, a feral guardian gains an animal companion, treating his warrior level as his effective beastmaster level for the purpose of this ability.\n\nThis ability replaces chosen weapon.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Animal Companion",
            "locator": "animal-companion"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:share-training",
        "name": "Share Training",
        "atLevel": 2,
        "description": "At 2nd level, when the animal companion can see and hear its master, it can use any combat feat possessed by the feral guardian. The animal companion doesn\u2019t have to meet the feat\u2019s prerequisites, but at the GM\u2019s discretion may be precluded from using certain combat feats due to its physical form. For example, a feral guardian\u2019s wolf companion with access to Exotic Weapon Proficiency (spiked chain) would not gain the ability to use spiked chains, since it doesn\u2019t have any limbs capable of properly handling them.\n\nThis ability replaces combat offenses.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Share Training",
            "locator": "share-training"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:warrior-talents",
        "name": "Warrior Talents",
        "atLevel": 2,
        "description": "At 2nd level, a feral guardian loses access to any warrior talent that interacts with chosen weapon, but instead gains access to beastmaster tricks, treating his warrior level as his effective beastmaster level for the purpose of this ability.\n\nThis ability may replace warrior talents.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Warrior Talents",
            "locator": "warrior-talents"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:nature-sense",
        "name": "Nature Sense",
        "atLevel": 3,
        "description": "At 3rd level, a feral guardian gains a +2 bonus on Knowledge (nature) and Survival checks.\n\nThis ability replace chosen knowledge.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Nature Sense",
            "locator": "nature-sense"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:critical-aim",
        "name": "Critical Aim",
        "atLevel": 14,
        "description": "A feral guardian\u2019s animal companion gains the bonus to critical hit range with its natural attacks instead.\n\nThis ability modifies critical aim.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Critical Aim",
            "locator": "critical-aim"
          }
        ]
      },
      {
        "id": "ffd20:archetype:warrior:feral-guardian:feature:assured-crits",
        "name": "Assured Crits",
        "atLevel": 16,
        "description": "A feral guardian\u2019s animal companion gains the bonus to critical hit confirmations with its natural attacks instead.\n\nThis ability modifies assured crits.\nSheet support: conditional combat bonuses, temporary forms, equipment, prerequisites and any extra subchoices are applied manually using existing sheet entries.",
