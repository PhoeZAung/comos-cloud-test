      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:weapon-and-armor-proficiency",
        "name": "Weapon and Armor Proficiency",
        "atLevel": 1,
        "description": "The skulking slayer gains proficiency with greatclubs and whips, but loses proficiency with rapiers and hand crossbows.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Weapon and Armor Proficiency",
            "locator": "weapon-and-armor-proficiency"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:underhanded-maneuvers",
        "name": "Underhanded Maneuvers",
        "atLevel": 1,
        "description": "At 1st level, when he could normally make a sneak attack, a slayer may instead make a dirty trick or steal combat maneuver with a bonus on his roll. This bonus is equal to his number of sneak attack dice for a dirty trick combat maneuver, or 1-1/2 \u00d7 his number of sneak attack dice for a steal combat maneuver.\n\nThis ability replaces trapfinding.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Underhanded Maneuvers",
            "locator": "underhanded-maneuvers"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:bonus-feats",
        "name": "Bonus Feats",
        "atLevel": 2,
        "description": "At 2nd level, a skulking slayer can select the [Surprise Follow-Through](https://www.finalfantasyd20.com/feats/racial-feats/surprise-follow-through-galka/) feat in place of a thief talent.\n\nAt 12th level, he can select the [Improved Surprise Follow-Through](https://www.finalfantasyd20.com/feats/racial-feats/improved-surprise-follow-through-galka/) feat in place of an advanced thief talent.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Bonus Feats",
            "locator": "bonus-feats"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:bold-strike",
        "name": "Bold Strike",
        "atLevel": 3,
        "description": "At 3rd level, when a skulking slayer charges and makes a sneak attack with a two-handed weapon, he rolls d8s instead of d6s for his sneak attack damage.\n\nThis ability replaces danger sense.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Bold Strike",
            "locator": "bold-strike"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:shifty",
        "name": "Shifty",
        "atLevel": 6,
        "description": "At 6th level, a skulking slayer gains a bonus on Bluff checks to feint equal to half his level.\n\nThis ability replaces the thief talent gained at 6th level.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Shifty",
            "locator": "shifty"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:skulking-slayer:feature:unexpected-charge",
        "name": "Unexpected Charge",
        "atLevel": 9,
        "description": "At 9th level, a skulking slayer can make a Bluff check to feint as a [swift action](https://www.finalfantasyd20.com/system-rules/pathfinder-basics/#swift) before a charge.\n\nThis ability replaces distraction.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "mixed",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Unexpected Charge",
            "locator": "unexpected-charge"
          }
        ]
      }
