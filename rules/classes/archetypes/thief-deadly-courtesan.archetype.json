  "data": {
    "features": [
      {
        "id": "ffd20:archetype:thief:deadly-courtesan:feature:bardic-performance",
        "name": "Bardic Performance",
        "atLevel": 2,
        "description": "At 2nd level, a deadly courtesan gains the [bardic performance](https://www.finalfantasyd20.com/classes/core-classes/bard/#bardic-performance) ability and the [fascinate](https://www.finalfantasyd20.com/classes/core-classes/bard/#fascinate) bardic performance. Her fascinate DC is 10 + half of her thief level + her Charisma modifier. She can use this bardic performance for a number of rounds per day equal to 1 + her Charisma modifier. At each level after 2nd, she can use bardic performance for 1 additional round per day. If the deadly courtesan also has bard levels, she may use these rounds for either class\u2019s fascinate bardic performance, and her bard and thief levels stack for determining her fascinate DC.\n\nThis ability replaces the thief talent gained at 2nd level.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "mixed",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Bardic Performance",
            "locator": "bardic-performance"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:deadly-courtesan:feature:inspire-competence",
        "name": "Inspire Competence",
        "atLevel": 3,
        "description": "At 3rd level, a deadly courtesan can use her bardic performance to [inspire competence](https://www.finalfantasyd20.com/classes/core-classes/bard/#inspire-competence). The bonus begins at +2 and increases by +1 for every six levels the courtesan has attained beyond 3rd (+3 at 9th and +4 at 15th).\n\nThis ability replaces all levels of danger sense.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Inspire Competence",
            "locator": "inspire-competence"
          }
        ]
      },
      {
        "id": "ffd20:archetype:thief:deadly-courtesan:feature:performance-strike",
        "name": "Performance Strike",
        "atLevel": 8,
        "description": "At 8th level, as a [swift action](https://www.finalfantasyd20.com/system-rules/pathfinder-basics/#swift), a deadly courtesan may expend rounds of bardic performance to gain a morale bonus on one attack roll. The amount of the bonus is equal to the number of bardic performance rounds expended (maximum bonus equal to half her thief level).\n\nThis ability replaces improved uncanny dodge.\nSheet reference: apply conditional effects manually; record weapon, skill, feat, companion and spell subchoices on existing sheet rows.",
        "activation": "mixed",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Performance Strike",
            "locator": "performance-strike"
          }
        ]
      }
    ],
