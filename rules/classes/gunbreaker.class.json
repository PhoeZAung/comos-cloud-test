    "features": [
      {
        "id": "ffd20:class:gunbreaker:feature:aurora",
        "name": "Aurora",
        "atLevel": 1,
        "description": "Swift action: gain fast healing 1 and a +1 morale bonus to AC for a number of rounds equal to Wisdom modifier, 3 + Wisdom modifier times/day. Apply these temporary effects manually.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Aurora",
            "locator": "aurora"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:gunsmith",
        "name": "Gunsmith",
        "atLevel": 1,
        "description": "Starting class equipment and a bonus feat. Equipment selection remains manual.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Gunsmith",
            "locator": "gunsmith"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:magicked-ammo",
        "name": "Magicked Ammo",
        "atLevel": 1,
        "description": "On loading, infuse up to 3 rounds at first level; each infused round adds +1 damage and counts as magic for overcoming damage reduction. Reloading and expenditure are manually tracked.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Magicked Ammo",
            "locator": "magicked-ammo"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:blast-shield",
        "name": "Blast Shield",
        "atLevel": 1,
        "description": "Use 2 infused rounds to grant +2 deflection AC or +2 resistance on saving throws to self/ally within 15 feet for Wisdom-modifier rounds. Apply to chosen recipient manually.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Blast Shield",
            "locator": "blast-shield"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:brutal-shell",
        "name": "Brutal Shell",
        "atLevel": 1,
        "description": "Use an infused round to grant 5 + Wisdom modifier temporary hit points to self/ally within 15 feet for up to 1 minute. Apply to the recipient manually.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Brutal Shell",
            "locator": "brutal-shell"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:no-mercy",
        "name": "No Mercy",
        "atLevel": 1,
        "description": "Swift Limit Break: +2 circumstance to attack and damage with a gun arm and +1 critical threat range for 1 round at first level. All effects are temporary and manual.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "No Mercy",
            "locator": "no-mercy"
          }
        ]
      },
      {
        "id": "ffd20:class:gunbreaker:feature:superbolide",
        "name": "Superbolide",
        "atLevel": 1,
        "description": "Swift Limit Break: creates a barrier with 11 HP and hardness 2 at first level, lasting up to 1 round. Track the barrier separately from current HP.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Superbolide",
            "locator": "superbolide"
          }
        ]
      }
