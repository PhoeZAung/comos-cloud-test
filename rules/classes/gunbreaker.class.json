        "id": "ffd20:class:gunbreaker:feature:aurora",
        "name": "Aurora",
        "atLevel": 1,
        "description": "Swift action: gain fast healing 1 and a +1 morale bonus to AC for a number of rounds equal to Wisdom modifier, 3 + Wisdom modifier times/day. Apply these temporary effects manually.",
