    "features": [
      {
        "id": "ffd20:class:chocobo-knight:feature:proficiencies",
        "name": "Weapon and Armor Proficiency",
        "atLevel": 1,
        "description": "Proficient with simple and martial weapons, knight swords, all armor, and shields including tower shields.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Weapon and Armor Proficiency",
            "locator": "proficiencies"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:chocobo-mount",
        "name": "Chocobo Mount",
        "atLevel": 1,
        "description": "Gain a loyal yellow chocobo companion using Chocobo Knight level as effective Beastmaster level. Use the mount progression table on the official class page; shared saves is excluded. Companion choices, attacks, and advancement are managed manually in this first-level integration.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Chocobo Mount",
            "locator": "chocobo-mount"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:mounted-combat",
        "name": "Mounted Combat",
        "atLevel": 1,
        "description": "In or Out of the Saddle grants Mounted Combat as a bonus feat. Apply its Ride-check protection under the feat conditions; the feat does not add a permanent AC bonus.",
        "activation": "passive",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Mounted Combat",
            "locator": "mounted-combat"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:challenge",
        "name": "Challenge",
        "atLevel": 1,
        "description": "Once per day at level 1, challenge one visible target as a swift action. Melee attacks against that target gain +1 damage. Take -2 AC against attacks from other creatures. The challenge ends when its target is dead or unconscious, or combat ends. Apply these conditional modifiers manually.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Challenge",
            "locator": "challenge"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:commanders-aura",
        "name": "Commander’s Aura",
        "atLevel": 1,
        "description": "Project one morale aura for 4 + Charisma modifier rounds per day at level 1. Start with a move action, switch with a swift action, and end with a free action. Select one of the official aura modes and apply its situational benefit manually; no aura bonus is permanently added to the sheet.",
        "activation": "active",
        "featureKind": "class_feature",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Commander’s Aura",
            "locator": "commanders-aura"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:fight-as-one",
        "name": "Fight as One",
        "atLevel": 1,
        "description": "Limit Break: rider and mount receive +2 morale to attacks, saves, and skill checks for 1 round at level 1; the mount can full-attack after a charge. Activate as a swift action. Effects are conditional and managed manually.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Fight as One",
            "locator": "fight-as-one"
          }
        ]
      },
      {
        "id": "ffd20:class:chocobo-knight:feature:supreme-overrun",
        "name": "Supreme Overrun",
        "atLevel": 1,
        "description": "Limit Break: rider and mount charge 60 feet in a line, dealing 1d6 damage per Chocobo Knight level to enemies in the area; Reflex DC 10 + half class level + Strength modifier halves damage. Adjudicate the charge manually.",
        "activation": "active",
        "featureKind": "limit_break",
        "automation": "manual",
        "sourceRefs": [
          {
            "sourceId": "main",
            "section": "Supreme Overrun",
            "locator": "supreme-overrun"
          }
        ]
      }
