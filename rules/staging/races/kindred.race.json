    "issues": [
      {
        "path": "/data",
        "reason": "Starting language is Common plus exactly one of Abyssal/Infernal. Race-specific required choice UI is missing, so do not auto-grant both.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Maw or Claw requires precisely one of two natural weapon packages; the wizard cannot resolve this choice automatically.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Fiendish Magery increases effective INT for mage spells/features only; never auto-increase ability score INT globally.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Vestigial Wings does not grant independent flight, and conditional Fly bonus requires a different flight source.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Deeper darkness 1/day and resistances await full action and resource support.",
        "blocking": true
      }
    ],
