    "reviewedBy": null,
    "reviewedOn": null,
    "issues": [
      {
        "path": "/features",
        "reason": "Tonkin understands rather than speaks starting Common and Tonberry. Spoken language grants must not be automatic.",
        "blocking": true
      },
      {
        "path": "/features",
        "reason": "Mute vocal spell restriction conflicts with ordinary Black Mage casting unless Silent Spell or Telepathic Spellcaster is implemented.",
        "blocking": true
      },
      {
        "path": "/data/alternateReplacements",
        "reason": "Dancing Lantern replaces only the torchlight spell-like portion of Lantern Bearer, not its light defenses. Keep this partial replacement blocked.",
        "blocking": true
      },
      {
        "path": "/data/heritages",
        "reason": "Palekin/Royalty replace the score vector and the +4 Stealth trait, not all stealth modifiers. Block heritage automation until reviewed.",
        "blocking": true
      },
      {
        "path": "/features",
        "reason": "20-foot speed is unaffected by armor/encumbrance; special stacking on bleed damage and conditional telepathy need manual cards.",
        "blocking": true
      }
    ],
