    "issues": [
      {
        "path": "/data/alternateReplacements",
        "reason": "Several alternates say they replace “skilled”, but standard trait is titled Skill Bonus. These aliases are mapped to Skill Bonus with manual-resolution blocker pending source clarification.",
        "blocking": true
      },
      {
        "path": "/data/alternateReplacements",
        "reason": "Scion of Mortality replaces only the Celestial starting language and alters the native subtype, NOT all Languages or Type. Its replacement is manual and disabled.",
        "blocking": true
      },
      {
        "path": "/data/alternateReplacements",
        "reason": "Monstrous Heritage requires exactly one of bite or claws; not auto-granted.",
        "blocking": true
      },
      {
        "path": "/data/favoredRewards",
        "reason": "Summoner DR progression has first choice 1 then subsequent +1/2 and a cap; manually track rather than assuming uniform +1/2 for all.",
        "blocking": true
      },
      {
        "path": "/features/spell-like-ability",
        "reason": "Daylight ability uses caster level equal to class level and CHA; not automatically known as a spell.",
        "blocking": true
      },
      {
        "path": "/data/favoredRewards",
        "reason": "Favored rewards depend on unreviewed class content; manual per-level fractions and either-or options must not be auto-applied.",
        "blocking": true
      },
      {
        "path": "/features",
        "reason": "Mechanics marked conditional or manual are displayed as source rule cards and require independent approval before automation.",
        "blocking": true
      }
    ],
