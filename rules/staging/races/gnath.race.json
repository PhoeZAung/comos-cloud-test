      },
      {
        "path": "/data",
        "reason": "Carrion Sense is restricted to corpses and creatures with 25% HP or less; it is not general-purpose scent.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Day Raider replaces both Darkvision and Light Sensitivity. Do not retain the latter effects after swapping.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Bond to the Land, Improved Exoskeleton, One Swarm One Will and Tempered all replace Exoskeleton; they conflict in wizard selection.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Swarming shared-space combat effects and the 50% armor price penalty from Improved Exoskeleton need manual handling.",
