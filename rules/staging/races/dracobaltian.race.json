  "review": {
    "state": "needs_review",
    "coverage": "partial",
    "reviewedBy": null,
    "reviewedOn": null,
    "issues": [
      {
        "path": "/features",
        "reason": "Blind but Lesser Blindsight requires Perception checks and relies on hearing/smell; scent has separate rules. Do not simply grant perfect automatic detection at 30 ft.",
        "blocking": true
      },
      {
        "path": "/features",
        "reason": "Natural claws primary/secondary, conditional Diplomacy penalty, and underground difficult terrain require runtime/manual adjudication.",
        "blocking": true
      },
      {
        "path": "/data/favoredRewards",
        "reason": "Four favored class options remain manual until class IDs/features and fractional cap handling are reconciled.",
        "blocking": true
      },
      {
        "path": "/review",
        "reason": "Staging-only source paraphrases and effects are not independent rules approval; source text is not bundled or licensed. Live wizard and sheet behavior has not been tested.",
        "blocking": true
      },
      {
        "path": "/choicePools/bonus-languages",
        "reason": "Source race page names high-INT options but does not spell out count/reselection mechanics; formula max(0, INT_MOD) is a provisional standard-system interpretation only, not approved for auto-application.",
        "blocking": true
      },
      {
        "path": "/data/standardTraitIds",
        "blocking": true,
        "reason": "Standard creation/testing supports printed STR/WIS/INT scores, humanoid/reptilian identity, land speed 40, Perception, six source-listed language options and owned +1 natural armor. Natural blindness, 30-foot Lesser Blindsight with hearing/smell and mandatory Perception checks, Scent, conditional Stability/Diplomacy and claws remain manual references. No ordinary sight/darkvision, automatic detection, quadruped size/carrying modifiers or general CMD/Diplomacy effect is inferred. Later initial-language entitlement history, alternates and independent full review pending."
      }
    ],
