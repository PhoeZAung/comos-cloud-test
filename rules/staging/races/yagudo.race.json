    "issues": [
      {
        "path": "/data",
        "reason": "Summary table calls Feathers of Gale 'Natural Armor' and Valiant Linguist 'Gifted Linguist'; detailed list names are used; bite is described as 'Bite (plus upgrade)' in table but no upgrade is specified in detailed text.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Valiant Linguist learns TWO languages per Linguistics rank and gives +4 Linguistics. Current wizard cannot record the language additions; track manually, do not auto-grant random languages.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Zealot Devotee gives a static +2 Knowledge (religion) plus one additional bonus for each five ranks; rank-scaling not yet implemented, do not treat +2 as entire bonus at higher ranks.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Magical Linguist has CHA>=11-dependent spell-like abilities and language/glyph spell descriptor effects; may not auto-grant spells under CHA 11 or award spell DC globally.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "All three alternates replace Valiant Linguist, and Sturdy Feathers additionally removes Zealot Devotee; never allow stacked linguist alternatives.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Source has racial archetype Nokizaru (Ninja); standalone archetype details remain outside race extraction.",
        "blocking": true
      }
    ],
