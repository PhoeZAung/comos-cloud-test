    "issues": [
      {
        "path": "/data",
        "reason": "Bond to the Land requires one of swamp or underground terrain. Wizard lacks a persisted racial terrain choice; block saving until recorded.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Water Tribe adds +20 swim movement to original 30 and allows breathing air/water, and removes Full Withdrawal. Current movement calculation is not verified, keep replacement unresolved.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Full Withdrawal requires active state, prone/drop items, spellcasting ban, duration, DR and concealment; should be displayed manually, not always-on.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Armor Non-Proficiency text actually states double armor cost unless self-crafted; do not revoke armor proficiencies.",
        "blocking": true
      },
      {
        "path": "/data",
        "reason": "Source repeatedly calls protection DR/5 Bludgeoning; interpretation as DR 5/bludgeoning needs verification.",
        "blocking": true
      }
    ],
