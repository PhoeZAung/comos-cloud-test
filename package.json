{
  "name": "comos-template",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node server.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "test:critical": "node --test tests/critical-effects.test.mjs tests/dice-themes.test.mjs tests/sheet-weapon.test.mjs tests/account.test.mjs",
    "test:critical:browser": "node scripts/build.mjs && node scripts/check-critical-effects-browser.mjs",
    "api": "node backend/main.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:live": "node scripts/build.mjs && node scripts/build-live.mjs",
    "build:cloud": "node scripts/build.mjs && node scripts/build-live.mjs public-auth.json",
    "start:cloud": "node backend/cloud.mjs",
    "rules:generate": "node scripts/generate-races.mjs",
    "rules:check": "node scripts/generate-races.mjs --check",
    "rules:class:new": "node scripts/new-class.mjs",
    "rules:class:check": "node scripts/generate-class-catalog.mjs --check",
    "rules:archetype:new": "node scripts/new-archetype.mjs",
    "rules:class:stage": "node scripts/stage-class.mjs",
    "rules:class:review": "node scripts/review-class.mjs",
    "imports:status": "node scripts/import-queue.mjs status",
    "imports:next": "node scripts/import-queue.mjs next",
    "imports:plan": "node scripts/import-queue.mjs plan",
    "items:progress": "node scripts/shopping-progress.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@3d-dice/dice-box": "1.1.4",
    "@owlbear-rodeo/sdk": "3.1.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "html-to-image": "1.11.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.180.0",
    "yjs": "13.6.33"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
